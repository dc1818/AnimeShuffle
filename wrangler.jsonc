{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime-shuffle",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "AnimeBackend" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AnimeBackend"] }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "ai": { "binding": "AI" },
  "vars": {
    "AI_TASTE_ENRICHMENT": "true",
    "AI_DAILY_REQUEST_LIMIT": "0",
    "AI_TASTE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
  },
}
