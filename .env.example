# Local use: copy to .env and keep credentials out of Git.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
PORT=5173
# Local MAL redirect: http://localhost:5173/auth/callback

# Hosted use: enter these in the hosting dashboard, not in this file.
# Render supplies RENDER_EXTERNAL_URL automatically; PUBLIC_ORIGIN overrides it.
# PUBLIC_ORIGIN=https://your-actual-domain.example
# ANIME_SHUFFLE_DATA_DIR=/var/data/anime-shuffle
# NODE_ENV=production
