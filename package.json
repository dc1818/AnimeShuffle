{
  "name": "anime-shuffle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local anime discovery and Plan to Watch helper",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "traits:api": "node --env-file-if-exists=.env scripts/import-api-traits.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check src/lib/store.js && node --check src/lib/recommend.js",
    "format": "prettier --write src lib server.mjs scripts test public/index.html package.json",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "wrangler": "^4.145.0"
  }
}
