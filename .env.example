# Local development: copy to .env and keep credentials out of Git.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
PORT=5173
# Register this MAL callback: http://localhost:5173/auth/callback

# Optional Node hosting configuration. Account storage must be persistent.
# PUBLIC_ORIGIN=https://your-domain.example
# ANIME_SHUFFLE_DATA_DIR=/path/to/persistent/storage
# NODE_ENV=production

# Exact authenticated account IDs allowed to use /admin (comma separated).
# Leave empty to deny all administrator access.
ADMIN_ACCOUNT_IDS=
